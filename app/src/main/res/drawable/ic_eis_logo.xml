<!--
    EIS brand mark — vector approximation of the orange "EIS" glyph
    (two interlocking rounded squares with a square-spiral cutout and
    a small accent dot, plus two thin stripes on the hoist edge).
    Replace this file with the official PNG/SVG when ready by uploading
    a `ic_eis_logo.png` (or `.svg`) to the same folder under any density
    bucket (mipmap-anydpi-v26/ic_eis_logo.xml works for adaptive icons).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Two thin vertical accent stripes on the hoist edge -->
    <path
        android:fillColor="#E97B2A"
        android:pathData="M14,32 L17,32 L17,90 L14,90 Z" />
    <path
        android:fillColor="#E97B2A"
        android:pathData="M21,32 L24,32 L24,90 L21,90 Z" />

    <!-- Main rounded square (the "e" body) -->
    <path
        android:fillColor="#E97B2A"
        android:pathData="M34,30 L74,30 A6,6 0 0 1 80,36 L80,84 A6,6 0 0 1 74,90 L34,90 A6,6 0 0 1 28,84 L28,36 A6,6 0 0 1 34,30 Z" />

    <!-- Square-spiral cutout in white inside the main shape -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,42 L70,42 L70,78 L46,78 L46,72 L64,72 L64,48 L46,48 L46,68 L52,68 L52,54 L58,54 L58,62 L52,62 L52,68 L40,68 Z" />

    <!-- Accent rounded square (the "j" tail) -->
    <path
        android:fillColor="#E97B2A"
        android:pathData="M84,42 L96,42 A4,4 0 0 1 100,46 L100,90 A6,6 0 0 1 94,96 L84,96 A4,4 0 0 1 80,92 L80,46 A4,4 0 0 1 84,42 Z" />

    <!-- Small dot above the accent square (the "j" dot) -->
    <path
        android:fillColor="#E97B2A"
        android:pathData="M85,22 L95,22 A3,3 0 0 1 98,25 L98,33 A3,3 0 0 1 95,36 L85,36 A3,3 0 0 1 82,33 L82,25 A3,3 0 0 1 85,22 Z" />
</vector>
