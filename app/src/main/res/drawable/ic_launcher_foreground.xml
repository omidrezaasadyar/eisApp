<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground. The bitmap fills the 108dp canvas; the
    launcher mask (circle / squircle / square) crops as needed. The
    logo is centered so the brand mark stays visible across launcher
    shapes.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_eis_logo"
    android:gravity="center|fill_horizontal"
    android:antialias="true" />
