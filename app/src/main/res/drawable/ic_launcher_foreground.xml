<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground using the dedicated 1024x1024 square
    launcher artwork. The bitmap fills the 108dp canvas; the launcher
    mask (circle / squircle / rounded square) crops as needed. Because
    the source artwork is already square with proper internal padding,
    the icon reads cleanly across all launcher shapes.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_launcher_logo"
    android:gravity="fill"
    android:antialias="true" />
